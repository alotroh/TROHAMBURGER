---
/**
 * Шапка. Навигация — обычные ссылки (работают без JS).
 * `transparent` — поверх тёмного hero на главной, затемняется при скролле.
 */
import { SITE, NAV, CTA, BUSINESS, CONTACTS } from '../config/site.mjs';
import Logo from './Logo.astro';

interface Props {
  transparent?: boolean;
  currentPath?: string;
}
const { transparent = false, currentPath = '' } = Astro.props;
---

<header class={`site-header${transparent ? ' site-header--transparent' : ''}`} data-header>
  <!-- Верхняя полоса: часы работы и телефон — как у настоящих заведений -->
  <div class="topbar">
    <div class="container topbar__inner">
      <span class="topbar__hours" aria-label="Часы работы">
        {BUSINESS.openingHoursDisplay.map((h) => (
          <span class="topbar__slot"><b>{h.label}</b> {h.value}</span>
        ))}
      </span>
      <span class="topbar__right">
        <span class="topbar__hand">жарим под заказ</span>
        {CONTACTS.phoneDisplay && <a class="topbar__phone" href={`tel:${CONTACTS.phoneRaw}`}>{CONTACTS.phoneDisplay}</a>}
      </span>
    </div>
  </div>

  <!-- Главная строка -->
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${SITE.brand}, на главную`}>
      <Logo class="brand__mark" size={44} />
      <span class="brand__text">
        <span class="brand__name">{SITE.brand}</span>
        <span class="brand__tag">{SITE.brandTagline}</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Основная навигация">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="site-header__cta" href="/zakaz/" data-track="click_order">
      <span class="site-header__cta-label">{CTA.order}</span>
      <span class="site-header__cta-ico" aria-hidden="true">→</span>
    </a>

    <button class="burger-btn" aria-label="Открыть меню" aria-expanded="false" data-burger>
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Мобильная навигация">
      <ul>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn mobile-menu__cta" href="/zakaz/">{CTA.order}</a>
    {CONTACTS.phoneDisplay && <a class="mobile-menu__phone" href={`tel:${CONTACTS.phoneRaw}`}>{CONTACTS.phoneDisplay}</a>}
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(13, 11, 9, 0.82);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line-soft);
    transition: background 0.4s var(--ease), border-color 0.4s var(--ease);
  }
  .site-header--transparent {
    position: absolute;
    left: 0; right: 0;
    background: transparent;
    backdrop-filter: none;
    border-color: transparent;
  }
  .site-header--transparent.is-scrolled {
    position: fixed;
    background: rgba(13, 11, 9, 0.9);
    backdrop-filter: blur(14px);
    border-color: var(--line-soft);
  }

  /* ---- Верхняя полоса (часы + телефон) ---- */
  .topbar {
    border-bottom: 1px solid var(--line-soft);
    overflow: hidden;
    max-height: 46px;
    transition: max-height 0.4s var(--ease), opacity 0.3s var(--ease), border-color 0.4s var(--ease);
  }
  /* При прокрутке верхняя полоса сворачивается — остаётся компактная шапка */
  .is-scrolled .topbar { max-height: 0; opacity: 0; border-color: transparent; }
  .topbar__inner {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    min-height: 42px;
    font-family: var(--font-body);
    font-size: 0.82rem; font-weight: 400; letter-spacing: 0;
    color: var(--cream-soft);
  }
  .topbar__hours { display: inline-flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
  .topbar__slot b { color: var(--cream); font-weight: 600; }
  .topbar__right { display: inline-flex; align-items: center; gap: 1.4rem; }
  .topbar__hand { font-family: var(--font-hand); font-size: 1.15rem; color: var(--amber); }
  .topbar__phone { color: var(--cream); font-weight: 600; transition: color 0.3s var(--ease); }
  .topbar__phone:hover { color: var(--amber); }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 74px;
  }

  .brand { display: flex; align-items: center; gap: 0.75rem; }
  .brand__mark {
    display: block;
    flex: none;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.45));
    transition: transform 0.5s var(--ease-back);
  }
  .brand:hover .brand__mark { transform: rotate(-10deg) scale(1.08); }
  .brand__text { display: flex; flex-direction: column; line-height: 1; }
  .brand__name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--cream);
  }
  .brand__tag {
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--amber);
    margin-top: 3px;
  }

  .site-nav { margin-left: auto; }
  .site-nav ul { display: flex; gap: 2rem; list-style: none; padding: 0; margin: 0; }
  .site-nav a {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cream);
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    opacity: 0.82;
    transition: border-color 0.3s var(--ease), opacity 0.3s var(--ease), color 0.3s var(--ease);
  }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] { opacity: 1; color: var(--amber); border-color: var(--amber); }

  /* Кнопка заказа — «билетик»: жёлтый блок со стрелкой в тёмном кружке */
  .site-header__cta {
    display: inline-flex; align-items: center; gap: 0.65em;
    padding: 0.5em 0.5em 0.5em 1.05em;
    background: var(--amber); color: #1a1206;
    border-radius: 10px;
    font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; letter-spacing: 0.08em; text-transform: uppercase;
    box-shadow: 0 8px 22px -12px rgba(255,180,0,0.8);
    transition: transform 0.4s var(--ease-back), box-shadow 0.4s var(--ease);
  }
  .site-header__cta:hover { transform: translateY(-2px) rotate(-1deg); box-shadow: 0 12px 26px -12px rgba(255,180,0,0.9); }
  .site-header__cta-ico {
    display: grid; place-items: center; width: 1.85em; height: 1.85em;
    border-radius: 8px; background: #1a1206; color: var(--amber); font-size: 0.95em;
    transition: transform 0.4s var(--ease);
  }
  .site-header__cta:hover .site-header__cta-ico { transform: translateX(3px); }

  .burger-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px; height: 44px;
    padding: 10px;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--cream);
  }
  .burger-btn span {
    display: block; height: 2.5px; width: 100%;
    background: currentColor; border-radius: 2px;
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
  }
  .burger-btn[aria-expanded='true'] span:first-child { transform: translateY(7.5px) rotate(45deg); }
  .burger-btn[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .burger-btn[aria-expanded='true'] span:last-child { transform: translateY(-7.5px) rotate(-45deg); }

  .mobile-menu {
    display: none;
    padding: 1.5rem var(--gutter) 2.5rem;
    background: var(--char-2);
    border-top: 1px solid var(--line-soft);
  }
  .mobile-menu[hidden] { display: none !important; }
  .mobile-menu ul { list-style: none; padding: 0; margin: 0 0 1.5rem; display: grid; gap: 0.2rem; }
  .mobile-menu a {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 2rem;
    padding: 0.5rem 0;
    color: var(--cream);
    border-bottom: 1px solid var(--line-soft);
  }
  .mobile-menu a:hover { color: var(--amber); }
  .mobile-menu__cta { width: 100%; justify-content: center; }
  .mobile-menu__phone {
    display: block; text-align: center; margin-top: 1rem;
    font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; letter-spacing: 0.06em;
    color: var(--amber); border-bottom: 0 !important; padding: 0;
  }

  @media (max-width: 940px) {
    .site-nav, .site-header__cta { display: none; }
    .burger-btn { display: flex; margin-left: auto; }
    .mobile-menu.is-open { display: block; }
  }
  @media (max-width: 760px) {
    .topbar__hand { display: none; }
    .topbar__inner { font-size: 0.76rem; }
    .topbar__hours { gap: 1rem; }
  }
  @media (max-width: 560px) {
    .topbar__hours { gap: 0.7rem; }
    .topbar__slot ~ .topbar__slot { display: none; }
    .topbar__phone { display: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header?.classList.contains('site-header--transparent')) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  if (burger && menu) {
    const toggle = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
      menu.hidden = !open;
      menu.classList.toggle('is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    };
    burger.addEventListener('click', () => toggle(burger.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggle(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        toggle(false);
        burger.focus();
      }
    });
  }
</script>
