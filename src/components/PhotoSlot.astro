---
/**
 * PHOTO SLOT — место под реальное фото.
 * ------------------------------------------------------------------
 * Пока настоящих снимков нет, здесь стоит оформленная заглушка с подписью,
 * ЧТО именно снять. Выглядит как часть дизайна, а не «битая картинка».
 *
 * Когда появится фото:
 *   1. положите файл в src/assets/media/
 *   2. импортируйте и передайте в проп `image` (astro:assets)
 *   — подпись-инструкция исчезнет, останется фото.
 *
 * Props:
 *   label  — короткая подпись слота (напр. «Кухня»)
 *   note   — что снять (инструкция; показывается только у заглушки)
 *   ratio  — соотношение сторон, напр. '4/5', '16/10', '1/1'
 *   image  — ImageMetadata реального фото (необязательно)
 *   alt    — alt для реального фото
 *   priority — грузить сразу (для верхних фото)
 */
import { Image } from 'astro:assets';

interface Props {
  label?: string;
  note?: string;
  ratio?: string;
  image?: ImageMetadata;
  alt?: string;
  sizes?: string;
  priority?: boolean;
}
const {
  label = 'Фото',
  note = '',
  ratio = '4/5',
  image,
  alt = '',
  sizes = '(max-width: 720px) 92vw, 40vw',
  priority = false,
} = Astro.props;
---

<figure class={`slot${image ? ' slot--filled zoomable' : ''}`} style={`--ratio:${ratio}`}>
  {image ? (
    <Image src={image} alt={alt} widths={[420, 640, 900, 1200]} sizes={sizes}
      loading={priority ? 'eager' : 'lazy'} class="slot__img" />
  ) : (
    <div class="slot__ph">
      <svg class="slot__cam" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 8h3l1.2-1.8h7.6L18 8h2a1.5 1.5 0 0 1 1.5 1.5v8A1.5 1.5 0 0 1 20 19H4a1.5 1.5 0 0 1-1.5-1.5v-8A1.5 1.5 0 0 1 4 8Z" stroke="currentColor" stroke-width="1.4"/>
        <circle cx="12" cy="13" r="3.4" stroke="currentColor" stroke-width="1.4"/>
      </svg>
      <span class="slot__label">{label}</span>
      {note && <span class="slot__note">{note}</span>}
      <span class="slot__hint">сюда фото</span>
    </div>
  )}
</figure>

<style>
  .slot {
    position: relative;
    margin: 0;
    aspect-ratio: var(--ratio);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--char-3);
  }
  .slot--filled { background: var(--char-2); }
  .slot__img { width: 100%; height: 100%; object-fit: cover; }

  .slot__ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
    padding: 1.5rem;
    border: 2px dashed rgba(255, 180, 0, 0.4);
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(45deg, rgba(255, 180, 0, 0.03) 0 12px, transparent 12px 24px);
    color: var(--cream-soft);
    transition: border-color 0.4s var(--ease), background 0.4s var(--ease);
  }
  .slot:hover .slot__ph {
    border-color: rgba(255, 180, 0, 0.75);
    background:
      repeating-linear-gradient(45deg, rgba(255, 180, 0, 0.06) 0 12px, transparent 12px 24px);
  }
  .slot__cam { width: 34px; height: 34px; color: var(--amber); opacity: 0.85; }
  .slot__label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--cream);
  }
  .slot__note {
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--cream-mute);
    max-width: 30ch;
  }
  .slot__hint {
    margin-top: 0.35rem;
    font-family: var(--font-hand);
    font-size: 1.15rem;
    color: var(--amber);
    transform: rotate(-4deg);
  }
</style>
