---
/**
 * Знак бренда — бургер в стиле неоновой вывески (монолайн, один цвет).
 * Отсылка к фасадным вывескам конкурентов: контурная булка с кунжутом,
 * волна салата, котлета, нижняя булка. Не эмодзи и не «клипарт».
 *
 * size — сторона в px.
 */
interface Props { size?: number; class?: string; }
const { size = 40, class: className = '' } = Astro.props;
---
<svg
  class={`logo-mark ${className}`}
  width={size} height={size}
  viewBox="0 0 44 42" fill="none"
  stroke="#FFB400" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"
  role="img" aria-label="TROHAMBURGER"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- верхняя булка -->
  <path d="M6 18C6 10 13.4 5 22 5C30.6 5 38 10 38 18Z"/>
  <!-- кунжут -->
  <g fill="#FFB400" stroke="none">
    <circle cx="15.5" cy="13" r="1"/>
    <circle cx="22" cy="10.4" r="1"/>
    <circle cx="28.5" cy="13" r="1"/>
  </g>
  <!-- салат (волна) -->
  <path d="M6.5 22.2Q9.5 18.9 12.5 22.2T18.5 22.2T24.5 22.2T30.5 22.2T37.5 22.2" stroke-width="2"/>
  <!-- котлета -->
  <path d="M8.5 27H35.5"/>
  <!-- нижняя булка -->
  <path d="M6 31H38C38 35 31.6 38 22 38C12.4 38 6 35 6 31Z"/>
</svg>
