---
/**
 * BURGER STAGE — крутящийся бургер как фон всего сайта.
 * ------------------------------------------------------------------
 * Фиксированный слой позади контента: чёрный фон + большой бургер по центру
 * + тёплое свечение. При прокрутке вниз бургер медленно поворачивается и
 * приближается (zoom), при прокрутке вверх — всё разворачивается обратно,
 * потому что трансформация привязана к абсолютному scrollY.
 *
 * Слой «veil» затемняется по мере прокрутки, чтобы текст ниже читался, а
 * бургер продолжал крутиться приглушённо на фоне.
 *
 * Управляется одним rAF-обработчиком скролла. Уважает prefers-reduced-motion.
 */
import { Image } from 'astro:assets';
// Бургер с вырезанным фоном (прозрачный PNG) — лежит на ровном градиенте
// без прямоугольника и ореола. Исходник: burger-hero.png (см. cutout).
import burger from '../assets/media/burger-cut.png';

/**
 * mode="video" (главная): вместо PNG — раскадровка видео (public/burger-frames/).
 * Кадры 000…080 — это отрезок «целый бургер → полностью разобран» (без
 * обратной сборки). При открытии виден статичный постер (кадр 000). Когда
 * пользователь прокручивает секцию [data-burger-explode], кадры листаются
 * 0 → 80 синхронно со скроллом, и бургер разлетается на ингредиенты.
 *
 * Чтобы прокрутка не «дёргалась», ВСЕ кадры предзагружаются заранее: пока
 * они грузятся, показывается постер, а canvas включается только когда набор
 * готов целиком. Кадр рисуется по размеру экрана (contain) на сплошном
 * тёмном фоне — тёмные края кадра растворяются в фоне без масок.
 */
interface Props { mode?: 'spin' | 'video' }
const { mode = 'spin' } = Astro.props;
---

{mode === 'video' ? (
  <div class="stage stage--video" aria-hidden="true" data-burger-video>
    <img
      class="stage__frame stage__poster"
      data-burger-poster
      src="/burger-frames/lg/000.webp"
      srcset="/burger-frames/sm/000.webp 854w, /burger-frames/lg/000.webp 1280w"
      sizes="100vw"
      width="1280"
      height="720"
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <canvas class="stage__frame stage__canvas" data-burger-canvas></canvas>
    <div class="stage__veil" data-burger-veil></div>
  </div>
) : (
  <div class="stage" aria-hidden="true">
    <div class="stage__orbit" data-burger-orbit>
      <Image
        src={burger}
        alt=""
        widths={[520, 760, 1040, 1320]}
        sizes="(max-width: 720px) 92vw, 760px"
        loading="eager"
        fetchpriority="high"
        class="stage__img"
      />
    </div>
    <div class="stage__veil" data-burger-veil></div>
    <!-- Поднимающийся «пар» над бургером -->
    <div class="stage__steam" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
  </div>
)}

<style>
  .stage {
    position: fixed;
    inset: 0;
    z-index: -2;
    /* Ровный, очень плавный градиент. Бургер вырезан из фона (прозрачный PNG),
       поэтому лежит на градиенте чисто — без прямоугольника и ореола. */
    background: linear-gradient(180deg, #181310 0%, #100c0a 45%, #0a0807 72%, #060505 100%);
    overflow: hidden;
    pointer-events: none;
  }

  .stage__orbit {
    position: absolute;
    left: 50%;
    top: 44%;
    transform: translate(-50%, -50%);
    will-change: transform;
  }
  /* Обёртка получает трансформацию скролла (JS), а картинка — лёгкое «дыхание».
     Так не конфликтуют CSS-анимация и JS-трансформация. */
  .stage__img {
    display: block;
    width: min(88vmin, 760px);
    height: auto;
    /* Фон уже вырезан в самом PNG — ни маски, ни блендинга не нужно. */
    animation: burgerBob 6s ease-in-out infinite;
    transform-origin: center 46%;
  }

  .stage__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 6, 4, 0) 0%, rgba(8, 6, 4, 0.55) 70%, rgba(8, 6, 4, 0.8) 100%);
    opacity: 0;
    will-change: opacity;
    transition: opacity 0.2s linear;
  }

  /* Пар */
  .stage__steam {
    position: absolute;
    left: 50%;
    top: 20%;
    width: 160px;
    height: 220px;
    transform: translateX(-50%);
    opacity: 0.5;
  }
  .stage__steam span {
    position: absolute;
    bottom: 0;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(246, 239, 225, 0.5), rgba(246, 239, 225, 0));
    filter: blur(4px);
    animation: steamRise 6s ease-in infinite;
  }
  .stage__steam span:nth-child(1) { left: 30%; animation-delay: 0s; }
  .stage__steam span:nth-child(2) { left: 50%; animation-delay: 2s; }
  .stage__steam span:nth-child(3) { left: 68%; animation-delay: 4s; }

  @keyframes burgerBob {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(0.6deg); }
  }
  @keyframes steamRise {
    0% { transform: translateY(0) scale(0.7); opacity: 0; }
    20% { opacity: 0.6; }
    100% { transform: translateY(-180px) scale(1.6); opacity: 0; }
  }

  /* ---------- Режим video: раскадровка ---------- */
  .stage--video {
    /* В центре — почти чёрный фон самого видео (края кадра в нём растворяются),
       к краям экрана мягко переходит в уголь сайта (--char), чтобы фон hero
       гармонировал с панелями ниже. */
    background: radial-gradient(125% 100% at 50% 42%, #070605 0%, #070605 46%, #0c0a08 100%);
  }
  /* Кадр ограниченного размера по центру — НЕ во весь экран: так бургер не
     растягивается выше нативного разрешения (остаётся чётким) и не давит.
     Края кадра размываем мягкой маской, чтобы 16:9-прямоугольник бесшовно
     растворялся в фоне. Постер и canvas делят одну геометрию. */
  .stage__frame {
    position: absolute;
    left: 50%;
    top: 46%;
    /* По высоте, но не крупнее 680px (< нативных 720 — без апскейла и мыла). */
    height: min(60vh, 680px);
    height: min(60svh, 680px);
    width: auto;
    aspect-ratio: 16 / 9;
    transform: translate(-50%, -50%);
    display: block;
    /* Мягко растворяем края кадра: сильнее по бокам (там пустой фон),
       слабее сверху/снизу (чтобы не срезать взлетевшую булку и соус). */
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0%, #000 15%, #000 85%, transparent 100%),
      linear-gradient(180deg, transparent 0%, #000 6%, #000 94%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, transparent 0%, #000 15%, #000 85%, transparent 100%),
      linear-gradient(180deg, transparent 0%, #000 6%, #000 94%, transparent 100%);
    mask-composite: intersect;
  }
  /* Постер лежит поверх, пока canvas не готов; затем плавно уступает ему. */
  .stage__poster { opacity: 1; transition: opacity 0.35s linear; }
  .stage__canvas { opacity: 0; transition: opacity 0.35s linear; }
  .stage--video.is-ready .stage__canvas { opacity: 1; }
  .stage--video.is-ready .stage__poster { opacity: 0; }

  /* Телефон: кадр по ширине (чуть с запасом) и выше по экрану — текст hero
     ложится под бургером. По-прежнему не крупнее нативной ширины (854). */
  @media (max-width: 760px) {
    .stage__frame {
      top: 33%;
      height: auto;
      width: min(140vw, 92vh);
    }
  }

  @media (max-width: 720px) {
    .stage__steam { display: none; }
    /* На телефоне бургер выше и чуть меньше — текст hero ложится под ним */
    .stage__orbit { top: 30%; }
    .stage__img { width: min(76vmin, 520px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage__img,
    .stage__steam span { animation: none; }
  }
</style>

<script>
  // Прокрутка → поворот + приближение бургера.
  const orbit = document.querySelector<HTMLElement>('[data-burger-orbit]');
  const veil = document.querySelector<HTMLElement>('[data-burger-veil]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (orbit && !reduce) {
    let ticking = false;

    const apply = () => {
      const y = window.scrollY;

      // Поворот растёт со скроллом (вниз — по часовой, вверх — обратно).
      const rot = y * 0.05;
      // Плавное приближение до предела: разгоняется на первых ~2000px и
      // упирается в потолок ~1.5×, чтобы бургер не занимал весь экран.
      const scale = 1 + Math.min(y, 2000) / 2000 * 0.5;
      // Лёгкий подъём вверх при прокрутке вниз.
      const lift = -Math.min(y, 2600) * 0.03;

      orbit.style.transform =
        `translate(-50%, calc(-50% + ${lift}px)) rotate(${rot}deg) scale(${scale})`;

      if (veil) {
        // Затемняем фон по мере ухода от первого экрана.
        veil.style.opacity = String(Math.min(y / 650, 1) * 0.6);
      }

      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(apply);
        ticking = true;
      }
    };

    apply();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }

  // ------------------------------------------------------------------
  // Режим video: прокрутка листает кадры 0…80 на canvas.
  // Статичный постер → при скролле секции разборки кадры листаются вперёд.
  // ------------------------------------------------------------------
  const vStage = document.querySelector<HTMLElement>('[data-burger-video]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-burger-canvas]');
  const ctx = canvas?.getContext('2d');

  if (vStage && canvas && ctx && !reduce) {
    const FRAMES = 81;   // кадров в public/burger-frames/{sm,lg}/ (000…080)
    const vVeil = vStage.querySelector<HTMLElement>('[data-burger-veil]');
    const explode = document.querySelector<HTMLElement>('[data-burger-explode]');
    const set = window.matchMedia('(max-width: 760px)').matches ? 'sm' : 'lg';
    const src = (i: number) => `/burger-frames/${set}/${String(i).padStart(3, '0')}.webp`;

    const imgs: (HTMLImageElement | null)[] = new Array(FRAMES).fill(null);
    let ready = false;

    // --- Геометрия скролла (пересчитывается на resize/load) ---
    // startY — где разборка начинается, endY — где бургер разобран целиком.
    // Берём границы из секции [data-burger-explode], поэтому разборка точно
    // укладывается в её «залипающую» прокрутку.
    let startY = 0;
    let endY = 1;
    const measure = () => {
      const vh = window.innerHeight;
      if (explode) {
        const r = explode.getBoundingClientRect();
        const top = r.top + window.scrollY;
        startY = Math.max(0, top - vh * 0.35);          // чуть раньше залипания
        endY = Math.max(startY + 1, top + r.height - vh); // конец залипания
      } else {
        startY = 0;
        endY = vh * 1.5;
      }
      // Размер canvas = его собственный CSS-бокс (размерный кадр), ×dpr.
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      const w = Math.max(1, Math.round(rect.width * dpr));
      const h = Math.max(1, Math.round(rect.height * dpr));
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
      }
      drawn = -1;
    };

    // Прогресс разборки 0…1 по абсолютному scrollY.
    const progress = () => {
      const y = window.scrollY;
      if (y <= startY) return 0;
      if (y >= endY) return 1;
      return (y - startY) / (endY - startY);
    };

    // --- Отрисовка кадра ---
    // Canvas по размеру равен кадру (16:9), поэтому просто растягиваем кадр
    // на весь холст. Размер и позиция заданы в CSS (.stage__frame), края
    // размыты маской — здесь только рисуем нужный кадр.
    let drawn = -1;
    const draw = (f: number) => {
      const i = Math.max(0, Math.min(FRAMES - 1, Math.round(f)));
      const img = imgs[i];
      if (!img || i === drawn) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      drawn = i;
    };

    // Плавно догоняем нужный кадр, чтобы скролл колесом не «щёлкал».
    let current = 0;
    let target = 0;
    let raf = 0;
    const tick = () => {
      current += (target - current) * 0.2;
      if (Math.abs(target - current) < 0.4) current = target;
      draw(current);
      raf = current !== target ? requestAnimationFrame(tick) : 0;
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };

    const update = () => {
      const p = progress();
      target = p * (FRAMES - 1);
      if (ready) kick();

      // Прогресс разборки для подписей в секции (CSS-переменная --p, 0…1)
      if (explode) explode.style.setProperty('--p', p.toFixed(3));

      // После полной разборки фон затемняется, чтобы контент ниже читался.
      if (vVeil) {
        const extra = (window.scrollY - endY) / (window.innerHeight * 0.8);
        vVeil.style.opacity = (Math.max(0, Math.min(1, extra)) * 0.72).toFixed(3);
      }
    };

    // --- Предзагрузка ВСЕХ кадров; постер держим, пока набор не готов. ---
    let loaded = 0;
    const onOne = () => {
      if (++loaded >= FRAMES && !ready) {
        ready = true;
        measure();
        draw(target);
        vStage.classList.add('is-ready');
        kick();
      }
    };
    for (let i = 0; i < FRAMES; i++) {
      const im = new Image();
      im.decoding = 'async';
      im.onload = () => { imgs[i] = im; onOne(); };
      im.onerror = onOne;
      im.src = src(i);
    }

    measure();
    update();

    let pending = false;
    window.addEventListener('scroll', () => {
      if (pending) return;
      pending = true;
      requestAnimationFrame(() => { pending = false; update(); });
    }, { passive: true });
    window.addEventListener('resize', () => { measure(); update(); draw(current); }, { passive: true });
    // Высота страницы меняется после загрузки шрифтов/картинок
    window.addEventListener('load', () => { measure(); update(); });
  }
</script>
