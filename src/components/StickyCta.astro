---
/**
 * Плавающая кнопка заказа. Появляется после прокрутки, прячется у формы заказа.
 */
import { CTA } from '../config/site.mjs';
---

<div class="sticky-cta" data-sticky-cta aria-hidden="true">
  <a class="btn btn--ember sticky-cta__btn" href="/zakaz/" data-track="click_order">
    {CTA.order} <span class="arrow" aria-hidden="true">→</span>
  </a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    z-index: 90;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    opacity: 0;
    transform: translateY(16px) scale(0.95);
    pointer-events: none;
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease-back);
  }
  .sticky-cta.is-visible { opacity: 1; transform: none; pointer-events: auto; }
  .sticky-cta__btn { box-shadow: 0 14px 34px -12px rgba(232, 64, 31, 0.6); }
  @media (max-width: 760px) {
    .sticky-cta { left: 1rem; right: 1rem; bottom: 1rem; }
    .sticky-cta__btn { width: 100%; justify-content: center; padding-block: 1em; }
  }
</style>

<script>
  const cta = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const target = document.querySelector('#zakaz');
  if (cta) {
    let nearForm = false;
    if (target && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => { nearForm = entries[0].isIntersecting; update(); },
        { rootMargin: '0px 0px -15% 0px' }
      ).observe(target);
    }
    const update = () => {
      const show = window.scrollY > 620 && !nearForm;
      cta.classList.toggle('is-visible', show);
      cta.setAttribute('aria-hidden', String(!show));
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
