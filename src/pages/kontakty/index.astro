---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoSlot from '../../components/PhotoSlot.astro';
import { CONTACTS, BUSINESS } from '../../config/site.mjs';
import { PHOTO } from '../../data/media.mjs';
import { restaurantSchema } from '../../config/schema.mjs';

const jsonLd = [restaurantSchema({ image: '/og-cover.svg' })];
---

<BaseLayout seoKey="contacts" jsonLd={jsonLd} showStickyCta={false}>
  <section class="page-hero panel">
    <div class="container">
      <span class="eyebrow">Контакты и доставка</span>
      <h1>Найти нас<br /><span class="flame">и накормить вас</span></h1>
      <p class="lead page-hero__lead">
        Заходите в зал, забирайте навынос или заказывайте домой. Ниже — всё, что нужно, чтобы до нас добраться.
      </p>
    </div>
  </section>

  <section class="section panel">
    <div class="container contacts">
      <!-- Карта / фото места -->
      <div class="contacts__map reveal">
        <PhotoSlot label="Фасад" image={PHOTO.facade} alt="Фасад бургерной вечером со светящейся вывеской" ratio="4/3" sizes="(max-width: 940px) 90vw, 52vw" priority={true} />
        <span class="contacts__pin stamp">мы тут</span>
      </div>

      <!-- Инфо -->
      <div class="contacts__info">
        <div class="contacts__block reveal">
          <span class="index-num">Адрес</span>
          <p class="contacts__addr">{BUSINESS.address.display}</p>
        </div>

        <div class="contacts__block reveal">
          <span class="index-num">Часы работы</span>
          <ul class="contacts__hours">
            {BUSINESS.openingHoursDisplay.map((h) => (
              <li><span>{h.label}</span><span class="contacts__hours-val">{h.value}</span></li>
            ))}
          </ul>
        </div>

        <div class="contacts__block reveal">
          <span class="index-num">Связаться</span>
          <div class="contacts__links">
            {CONTACTS.phoneDisplay && <a class="btn" href={`tel:${CONTACTS.phoneRaw}`}>{CONTACTS.phoneDisplay}</a>}
            {CONTACTS.telegram && <a class="btn btn--ghost" href={CONTACTS.telegram} target="_blank" rel="noopener">Telegram</a>}
            {CONTACTS.whatsapp && <a class="btn btn--ghost" href={CONTACTS.whatsapp} target="_blank" rel="noopener">WhatsApp</a>}
          </div>
          {CONTACTS.email && <p class="muted contacts__email">По вопросам сотрудничества: <a href={`mailto:${CONTACTS.email}`}>{CONTACTS.email}</a></p>}
        </div>
      </div>
    </div>
  </section>

  <!-- Доставка -->
  <section class="section panel--solid">
    <div class="container">
      <div class="section-head reveal">
        <span class="index-num">Доставка</span>
        <h2>Привезём <span class="flame">горячим</span></h2>
      </div>
      <div class="delivery">
        <div class="delivery__item reveal" style="--i:0">
          <span class="delivery__ico" aria-hidden="true">🛵</span>
          <h3>Свои курьеры</h3>
          <p class="muted">По ближним районам возим сами. Пишите в мессенджер — подтвердим адрес, состав и время.</p>
        </div>
        <div class="delivery__item reveal" style="--i:1">
          <span class="delivery__ico" aria-hidden="true">📦</span>
          <h3>Собираем плотно</h3>
          <p class="muted">Бургер и картошку пакуем раздельно, чтобы по дороге ничего не размякло. Соус — в отдельной баночке.</p>
        </div>
        <div class="delivery__item reveal" style="--i:2">
          <span class="delivery__ico" aria-hidden="true">⏰</span>
          <h3>Обычно ~40 минут</h3>
          <p class="muted">Зависит от загрузки и погоды. В час пик честно предупредим, если дольше.</p>
        </div>
      </div>
      <p class="muted delivery__note reveal">
        Точная зона и минимальная сумма заказа появятся здесь, когда откроем доставку на реальной точке.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .contacts { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .contacts__map { position: relative; }
  .contacts__pin { position: absolute; top: -1rem; right: -0.5rem; font-size: 1.1rem; }
  .contacts__info { display: grid; gap: 2.25rem; }
  .contacts__block .index-num { display: block; margin-bottom: 0.8rem; }
  .contacts__addr { font-size: 1.05rem; color: var(--ink-soft); max-width: 34ch; }
  .contacts__hours { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .contacts__hours li { display: flex; justify-content: space-between; gap: 1rem; max-width: 22rem; color: var(--ink-soft); border-bottom: 1px solid var(--line-soft); padding-bottom: 0.5rem; }
  .contacts__hours-val { color: var(--cream); font-family: var(--font-display); font-weight: 600; }
  .contacts__links { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .contacts__email { margin-top: 1rem; font-size: 0.9rem; }
  .contacts__email a { color: var(--amber); border-bottom: 1px solid var(--line); }

  .delivery { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.25rem, 2.5vw, 2rem); }
  .delivery__item {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--char-3);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
  }
  .delivery__ico { font-size: 2rem; display: block; margin-bottom: 0.9rem; }
  .delivery__item h3 { margin-bottom: 0.5rem; }
  .delivery__note { margin-top: 2rem; font-size: 0.88rem; }

  @media (max-width: 940px) {
    .contacts { grid-template-columns: 1fr; }
    .delivery { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; }
  }
</style>
